# --- Application ---
APP_NAME=CFA Candidate-to-Member Onboarding POC
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# When no API key is present the app falls back to deterministic rule-based output.
LLM_ENABLED=true

# --- Postgres ---
DATABASE_URL=postgresql+psycopg://onboarding:onboarding@localhost:5432/onboarding

# --- Local directory storage (mock data / uploaded files) ---
DATA_DIR=./data/mock

# --- MCP ---
MCP_CONFIG_PATH=./mcp.config.json

# --- Google A2A ---
A2A_BASE_URL=http://localhost:8000
